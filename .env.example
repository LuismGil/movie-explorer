# Server-side only — never set as VITE_
TMDB_API_KEY=your_tmdb_v3_key_here

# Planned Google provider — Next.js server only, never NEXT_PUBLIC_ or VITE_
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# Optional: operator-only access to process-local aggregate AI telemetry (at least 32 characters)
AI_TELEMETRY_API_KEY=

# Free-tier admission counter — Next.js server only; blank means fail closed.
# Use Upstash Redis Free WITHOUT a payment method. Never NEXT_PUBLIC_ or VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
